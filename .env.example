# ============================ Core ============================
# development | production. Production FAILS CLOSED: startup aborts on weak secrets and webhooks
# without a configured secret are rejected (see docs/SECURITY.md).
APP_ENV=development
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Rotation without logging everybody out: put the old secret(s) here (comma-separated), then remove later.
JWT_SECRET_PREVIOUS=
DATABASE_URL=sqlite+aiosqlite:///./pia.db
# Postgres + pgvector: DATABASE_URL=postgresql+asyncpg://pia:pia@localhost:5432/pia
# Initial administrator: python -m app.security.admin admin@example.com
# Public registration always creates a regular user.
# Docker Postgres password (must match the existing volume on upgrades):
POSTGRES_PASSWORD=
# Failed logins per e-mail before a lockout (0 = off) and lockout length.
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=900

# Fernet key(s) for encryption AT REST: LLM API keys, chat history, TOTP secrets, uploaded files.
# Comma-separated for rotation (first encrypts, all decrypt; then run `python -m app.security.rekey`).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PIA_AGENT_SECRET=
ENCRYPT_BLOBS=true

BLOB_STORAGE_DIR=./data/blobs
MAX_UPLOAD_BYTES=20971520

# ============================ Queue / scaling ============================
# sync = answer inside the HTTP request (dev); queue = background worker + SSE (prod)
MESSAGE_MODE=queue
# inprocess = single instance (jobs are still persisted and recovered after restart)
# redis     = multi-replica: durable queue, cross-process SSE and Stop (needs REDIS_URL)
QUEUE_BACKEND=inprocess
REDIS_URL=
QUEUE_CONCURRENCY=4
# false on API pods when dedicated workers run `python -m app.worker`
EMBEDDED_WORKER=true
JOB_MAX_ATTEMPTS=3
JOB_STALE_SECONDS=120

# ============================ LLM ============================
# When a user's *local* LLM fails and this is true, retry with the fallback cloud endpoint below.
LLM_ALLOW_LOCAL_FALLBACK=false
# Production: exact trusted endpoints, including local ones when required.
LLM_ALLOWED_BASE_URLS=https://api.openai.com/v1
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
# Increment when replacing weights behind the same model name, then force reindex.
EMBEDDING_REVISION=1
# pgvector column width (Postgres). Must match your embedding model (1536 = text-embedding-3-small).
PGVECTOR_DIMENSIONS=1536
# Per-user LLM-bound messages per minute (0 = off) and max concurrent outbound LLM calls per process.
RATE_LIMIT_LLM_PER_MINUTE=0
LLM_MAX_CONCURRENCY=8
# Outbound HTTP retries (LLM, channels, STT): exponential backoff with jitter, honors Retry-After.
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_BASE_DELAY=0.5
HTTP_RETRY_MAX_DELAY=8
# Photo/PDF-extracted records wait for the user's confirm/reject before entering the knowledge base.
CONFIRM_EXTRACTED_FACTS=true

# ============================ Channels ============================
# Webhook secrets are REQUIRED in production for every enabled channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Slack Events API + interactivity (request URL: /v1/channels/slack/interactive)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
# WhatsApp Cloud API (Meta): webhook /v1/channels/whatsapp/webhook
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Discord Interactions endpoint: /v1/channels/discord/interactions (register slash commands:
# python -m app.channels.discord_register)
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# ============================ Speech-to-text (voice messages) ============================
# OpenAI-compatible /audio/transcriptions (Whisper, faster-whisper...); empty = disabled
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# ============================ Observability ============================
LOG_FORMAT=text
LOG_LEVEL=INFO

# ============================ Evals ============================
# python -m evals.runner            scripted LLM, deterministic (runs in CI on every PR)
# python -m evals.runner --live     real LLM (CI: .github/workflows/evals-live.yml, secret EVAL_LLM_API_KEY)
# EVAL_LLM_API_KEY=
# EVAL_LLM_BASE_URL=https://api.openai.com/v1
# EVAL_LLM_MODEL=gpt-4o-mini

# ============================ Proactive reminders (Telegram) ============================
REMINDERS_ENABLED=true
REMINDER_CHECK_SECONDS=300
REMINDER_KM_THRESHOLD=500

# ============================ HTTP ============================
# Explicit origins in production (comma-separated); "*" is rejected there.
CORS_ORIGINS=http://localhost:8000
RATE_LIMIT_AUTH_PER_MINUTE=10   # per client IP; 0 = disabled
# Set to true ONLY behind a reverse proxy that appends the real client IP to X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# ============================ Public launch ============================
# Enable only with real values. Startup validates required launch configuration.
PUBLIC_LAUNCH=false
PUBLIC_BASE_URL=
PIA_DOMAIN=
OPERATOR_NAME=
SUPPORT_EMAIL=
PRIVACY_URL=
TERMS_URL=
REQUIRE_VERIFIED_EMAIL=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
DEFAULT_LLM_BASE_URL=https://api.openai.com/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=gpt-4o-mini
ACCOUNT_EXPORT_MAX_BYTES=104857600
# Separate durable deletion journal: must survive restoring an older database.
DELETION_JOURNAL_PATH=
BACKUP_RETENTION_DAYS=30
# Separate Fernet key, NEVER included in a backup. Keep app keys separately too.
BACKUP_ENCRYPTION_KEY=

# Registration control is separate from PUBLIC_LAUNCH (release readiness checks).
REGISTRATION_ENABLED=true
# Empty means no allowlist. A closed pilot can list participant emails.
REGISTRATION_ALLOWED_EMAILS=
# Empty disables both optional domains; the knowledge base remains available.
ENABLED_DOMAINS=automotive,medical_labs
AGENT_CONTEXT_MAX_CHARS=100000
# Count ONLY known proxy hops; nginx's default config replaces X-Forwarded-For.
TRUSTED_PROXY_HOPS=1

# Maximum generated tokens for each chat/vision/structured/streaming model call.
LLM_MAX_OUTPUT_TOKENS=4096
# Admission limits, persisted in DB; 0 disables the corresponding request limit.
MAX_ACTIVE_JOBS_PER_USER=4
# UTC calendar day; REST/messenger messages and MCP calls share this allowance.
LLM_REQUESTS_PER_DAY=200
