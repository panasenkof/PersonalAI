# --- Core ---
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite+aiosqlite:///./pia.db
# Postgres: DATABASE_URL=postgresql+asyncpg://pia:pia@localhost:5432/pia

# Fernet key (urlsafe base64, 32 bytes) for encrypting stored LLM API keys.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PIA_AGENT_SECRET=

BLOB_STORAGE_DIR=./data/blobs
MAX_UPLOAD_BYTES=20971520

# --- LLM ---
# When a user's *local* LLM fails and this is true, retry with the fallback cloud endpoint below.
LLM_ALLOW_LOCAL_FALLBACK=false
FALLBACK_BASE_URL=https://api.openai.com/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# --- Channels ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Slack Events API (https://api.slack.com/apps): signing secret verifies payloads,
# bot token (xoxb-...) lets the bot post replies. Empty = channel disabled/dev.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# --- Speech-to-text (voice messages) ---
# OpenAI-compatible /audio/transcriptions (Whisper, faster-whisper...); empty = disabled
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# --- Observability ---
LOG_FORMAT=text
LOG_LEVEL=INFO

# --- Evals ---
# PIA_EVAL_LIVE=1 runs the golden set against the real LLM (costs tokens)

# --- Processing ---
# sync = answer inside the HTTP request (dev); queue = background worker + SSE (prod)
MESSAGE_MODE=queue
QUEUE_CONCURRENCY=4

# --- Proactive reminders (Telegram) ---
REMINDERS_ENABLED=true
REMINDER_CHECK_SECONDS=300
REMINDER_KM_THRESHOLD=500

# --- HTTP ---
CORS_ORIGINS=*
RATE_LIMIT_AUTH_PER_MINUTE=10   # 0 = disabled (dev default; compose sets 10)
