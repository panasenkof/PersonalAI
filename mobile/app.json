{
  "expo": {
    "name": "PersAI",
    "slug": "pia-agent",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Разрешите PersAI использовать Face ID для входа в приложение."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Разрешите микрофон для голосового ввода в PersAI.",
          "speechRecognitionPermission": "Разрешите преобразование речи в текст.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFF",
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8FAFF"
      }
    },
    "description": "Ваш помощник для диалогов, документов и личной базы знаний"
  }
}
