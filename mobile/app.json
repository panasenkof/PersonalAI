{
  "expo": {
    "name": "PersAI",
    "slug": "pia-agent",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-sharing",
        {
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "image/*",
              "audio/*",
              "video/*",
              "text/*",
              "application/json"
            ],
            "multipleShareMimeTypes": [
              "image/*",
              "audio/*",
              "video/*"
            ]
          },
          "ios": {
            "enabled": false
          }
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Разрешите PersAI использовать Face ID для входа в приложение."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Разрешите микрофон для голосового ввода в PersAI.",
          "speechRecognitionPermission": "Разрешите преобразование речи в текст.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": true
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#070D20",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#070D20",
            "image": "./assets/splash.png"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "17.0"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": false,
          "cameraPermission": "Камера нужна, чтобы сфотографировать и распознать сведения."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.persai.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#070D20",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "description": "Ваш помощник для диалогов, документов и личной базы знаний",
    "scheme": "persai"
  }
}
