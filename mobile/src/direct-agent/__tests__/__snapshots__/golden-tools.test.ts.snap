            "section",
            "kind",
            "person",
            "date"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "update_task_state",
        "description": "Уточнить рабочую цель, выбранный вариант и открытые вопросы этого диалога. Не сохраняет личные факты и не подтверждает успех инструментов. Используй при смене темы/выбора, по возможности вместе с нужным инструментом в одном ходе; для простого ответа не требуется.",
        "parameters": {
          "type": "object",
          "properties": {
            "goal": {
              "type": "string",
              "maxLength": 600
            },
            "selection": {
              "type": "string",
              "maxLength": 400
            },
            "openQuestions": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              },
              "maxItems": 5
            }
          },
          "required": [
            "goal",
            "selection",
            "openQuestions"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "workspace_put",
        "description": "Сохранить ОДИН промежуточный черновик, задачу или сравнение в рабочей области ЭТОЙ задачи и зашифрованного диалога. Не личная память; не факт и не источник доказательства. Не копируй полный текст статей. До 16 ключей, по 1200 символов. Один и тот же key заменяется.",
        "parameters": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "maxLength": 32,
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "finding",
                "todo",
                "question",
                "comparison"
              ]
            },
            "content": {
              "type": "string",
              "maxLength": 1200
            }
          },
          "required": [
            "key",
            "kind",
            "content"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "workspace_list",
        "description": "Список коротких ключей рабочей области ТЕКУЩЕЙ задачи. Содержимое и оригиналы тут НЕ возвращаются; для них workspace_get/доказательный source-read.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      },
      {
        "name": "workspace_get",
        "description": "Прочитать ОДИН промежуточный черновик модели по ключу, не оригинал. Прежде чем приводить факты, перечитай исходный документ с версионированным source reader.",
        "parameters": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "maxLength": 32
            }
          },
          "required": [
            "key"
          ],
          "additionalProperties": false
        }
      },
      {
        "name": "workspace_clear",
        "description": "Очистить ТОЛЬКО рабочие черновики текущего диалога (например, при смене задачи). Оригинальные заметки, документы, подтверждённые действия и историю чата не трогает.",
        "parameters": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        }
      }
    ]
  },
  {
    "name": "context-only",
    "definitions": [
      {
        "name": "set_conversation_context",
        "description": "Определить или исправить ТЕМУ и РАЗДЕЛ текущего диалога — не переносит, не сохраняет и не читает записи памяти. Вызывай при первой содержательной теме и при явном изменении темы/раздела, включая запрос пользователя исправить классификацию. Не вызывай из-за короткого уточнения. Раздел — только существующий slug; если не уверен, null. При закреплённом разделе менять можно только тему. Приложение покажет изменение в конце ответа ПОСЛЕ успешного сохранения истории, не повторяй статус в тексте.",
        "parameters": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80,
              "description": "Короткое содержательное название темы на языке пользователя."
            },
            "sectionSlug": {
              "type": [
                "string",
                "null"
              ],
              "description": "Точный slug уже существующей коллекции: . null при отсутствии основания."
            },
            "reason": {
              "type": "string",
              "minLength": 2,
              "maxLength": 180,
              "description": "Одно короткое основание по текущему пользовательскому сообщению или реально прочитанным вложениям."
            }
          },
          "required": [
            "topic",
            "sectionSlug",
            "reason"
          ],
          "additionalProperties": false
        }
      }
    ]
  },
  {
    "name": "context-only-with-import-tags",
    "definitions": [
      {
        "name": "propose_import_metadata",
        "description": "Предложить существующий раздел, тему и до 5 тематических тегов только по предоставленному читаемому тексту. При сомнении sectionSlug=null и tags=[]. Это предложение, не запись.",
        "parameters": {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string",
              "minLength": 2,
              "maxLength": 80
            },
            "sectionSlug": {
              "type": [
                "string",
                "null"
              ],
              "description": "Slug только разрешённого раздела из: ; либо null."
            },
            "reason": {
              "type": "string",
              "minLength": 2,
              "maxLength": 180
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              },
              "maxItems": 5,
              "description": "0–5 точных смысловых тегов на русском, без # и пробелов. Только из действительно прочитанного содержания."
            }
          },
          "required": [
            "topic",
            "sectionSlug",
            "reason",
            "tags"
          ],
          "additionalProperties": false
        }
      }
    ]
  }
]
`;
